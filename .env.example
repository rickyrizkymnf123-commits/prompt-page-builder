# ========================================
# FRONTEND (Vite) — required
# ========================================
# These are auto-generated by Lovable Cloud. Copy from your project's .env (or Cloud dashboard).
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# ========================================
# EDGE FUNCTIONS (Supabase secrets) — set via `supabase secrets set` or dashboard
# Not needed for `npm run dev` (frontend only). Required if you deploy/run edge functions locally.
# ========================================

# Auto-provided by Supabase runtime (only set manually for local `supabase functions serve`)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_DB_URL="postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres"

# Lovable AI Gateway (for AI features in edge functions)
LOVABLE_API_KEY="your-lovable-ai-key"

# Provisioning / Webhook gateway
PROVISION_SECRET="your-hmac-shared-secret"
SCALEV_SLUG_MAP="slug-a:LPE,slug-b:SWA,slug-c:PEA,slug-d:PSI"
ROUTE_SWA_URL="https://<story-weaver-project>.supabase.co/functions/v1/provision"
ROUTE_PEA_URL="https://<property-enhancer-project>.supabase.co/functions/v1/provision"

# WhatsApp notifications (WAHA)
WAHA_API_URL="https://your-waha-instance.com"
WAHA_API_KEY="your-waha-api-key"
WAHA_SESSION_NAME="default"

# App
APP_DOMAIN="https://your-domain.com"
